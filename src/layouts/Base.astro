---
import "../styles/global.css";
import CartCount from "../components/CartCount";
type World = "home" | "bf" | "pp";
const { title = "Bruffles Apparel × Passport to Paradise", description = "Authentic one-of-one menswear from Bruffles Apparel, and accessories from Passport to Paradise.", world = "home" } =
  Astro.props as { title?: string; description?: string; world?: World };
const lockup = world === "bf" ? "BA" : world === "pp" ? "PTP" : "BA × PTP";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><script is:inline>document.documentElement.classList.add("js")</script><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Bruffles Apparel × Passport to Paradise" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
  <link rel="icon" href="/brand/bruffles-monogram-gold-deep.webp" />
</head>
<body class:list={["min-h-svh", world === "pp" ? "pp" : "bf"]}>
  <header class:list={["fixed top-0 inset-x-0 z-30 h-16", world === "pp" ? "bg-char/95 text-paper border-b border-char-3" : "bg-bone/95 text-ink border-b border-hair"]}>
    <nav class="wrap h-full grid grid-cols-[1fr_auto_1fr] items-center">
      <div class="flex gap-6 label-bf"><a href="/bruffles">Bruffles</a><a href="/passport">Passport</a></div>
      <a href="/" class:list={["text-[20px]", world === "pp" ? "h-pp" : "h-bf"]}>{lockup}</a>
      <div class="flex justify-end label-bf"><CartCount client:load /></div>
    </nav>
  </header>
  <main><slot /></main>
  <script>
    // Reveal on scroll. A wipe starts fully clipped, so we watch its parent (clipped boxes can read as hidden).
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = (e.target as HTMLElement & { _rv?: Element })._rv ?? e.target;
      el.classList.add("is-in"); io.unobserve(e.target);
    }), { threshold: 0.15 });
    document.querySelectorAll(".rise").forEach((el) => io.observe(el));
    document.querySelectorAll(".wipe").forEach((el) => { const host = el.parentElement!; (host as any)._rv = el; io.observe(host); });
  </script>
</body>
</html>
