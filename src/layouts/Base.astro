---
import "../styles/global.css";
// Preload the UI font so labels don't jump when it arrives (was the main layout shift on /bruffles).
import uiFont from "@fontsource/archivo-narrow/files/archivo-narrow-latin-400-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AgeGate from "../components/AgeGate.astro";
type World = "home" | "bf" | "pp";
const { title = "Bruffles Apparel × Passport to Paradise", description = "Authentic one-of-one menswear from Bruffles Apparel, and accessories from Passport to Paradise.", world = "home", image, shop = false, white = false, offset = true } =
  Astro.props as { title?: string; description?: string; world?: World; image?: string; shop?: boolean; white?: boolean; offset?: boolean };
// The shop header (promo bar + logo bar + menu row) is 80px taller than the plain bar. Pages written
// for the plain bar get that much extra room on top; pages that already allow for it pass offset={false}.
// Share image (WhatsApp, iMessage, Facebook): Divine's merged BA × PTP circle (2026-11-26) unless a page passes its own
// (product pages pass the piece photo). WhatsApp wants an absolute https URL, 1200×630, under ~300 KB.
const SITE = Astro.site ?? "https://bruffles-apparelxptp.neikoliaugustine.workers.dev";
const ogImage = new URL(image ?? "/brand/og-ba-x-ptp-v2.jpg", SITE).href;
const ogUrl = new URL(Astro.url.pathname, SITE).href;
---
<!doctype html>
<html lang="en">
<head>
  <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
  <meta charset="utf-8" /><script is:inline>document.documentElement.classList.add("js")</script><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Bruffles Apparel × Passport to Paradise" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:image" content={ogImage} /><meta property="og:image:secure_url" content={ogImage} />
  {!image && <><meta property="og:image:type" content="image/jpeg" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Bruffles Apparel × Passport to Paradise circular badge with a plane and palm trees: Feel the authentic peace" /></>}
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={ogImage} /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
  <link rel="icon" href="/brand/bruffles-monogram-gold-deep.webp" />
  <slot name="head" />
</head>
<body class:list={["min-h-svh", world === "pp" ? "pp" : "bf", shop && "shop", white && "page-white"]}>
  <Header world={world} shop={shop} />
  <main class:list={[shop && offset && "pt-20"]}><slot /></main>
  <Footer world={world} />
  {world === "pp" && <AgeGate />}
  <script>
    // Reveal on scroll. A wipe starts fully clipped, so we watch its parent (clipped boxes can read as hidden).
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = (e.target as HTMLElement & { _rv?: Element })._rv ?? e.target;
      el.classList.add("is-in"); io.unobserve(e.target);
    }), { threshold: 0.15 });
    document.querySelectorAll(".rise, [data-flip], .wall-card").forEach((el) => io.observe(el));
    document.querySelectorAll(".wipe").forEach((el) => { const host = el.parentElement!; (host as any)._rv = el; io.observe(host); });

    // Looping reveal (homepage Latest pieces, Divine 2026-11-25): every time a card comes up into view
    // it rises and fades in; when it drops back below the screen (scrolling up) it sinks and fades out.
    // A card that scrolls off the top stays put. The photo is fetched as the card nears the screen
    // (300px ahead) and decoded off the main thread first, so the card never rises as an empty box.
    const near = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const img = e.target.querySelector("img");
      if (img) { img.loading = "eager"; (e.target as any)._ready = img.decode().catch(() => {}); }
      near.unobserve(e.target);
    }), { rootMargin: "300px 0px" });
    const loop = new IntersectionObserver((es) => es.forEach((e) => {
      const el = e.target as HTMLElement & { _ready?: Promise<void>; _t?: number };
      if (e.isIntersecting) {
        const show = () => el.classList.add("is-in");
        Promise.race([el._ready ?? Promise.resolve(), new Promise((r) => setTimeout(r, 700))]).then(show);
      } else if (e.boundingClientRect.top > 0) el.classList.remove("is-in");
    }), { threshold: 0.12 });
    document.querySelectorAll(".reveal-loop").forEach((el) => { near.observe(el); loop.observe(el); });
  </script>
</body>
</html>
