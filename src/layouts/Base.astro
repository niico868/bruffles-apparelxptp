---
import "../styles/global.css";
import CartCount from "../components/CartCount";
const { title = "Bruffles Apparel × Passport to Paradise", description = "Authentic one-of-one menswear and bulk accessories." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><script is:inline>document.documentElement.classList.add("js")</script><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Bruffles Apparel × Passport to Paradise" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
</head>
<body class="min-h-svh">
  <!-- Shared chrome: one clean sans so both brands feel like one store -->
  <header class="sticky top-0 z-30 h-14 bg-[#fbfaf7]/90 backdrop-blur border-b border-line">
    <nav class="h-full max-w-[1400px] mx-auto px-4 md:px-8 flex items-center justify-between text-[13px]">
      <div class="flex gap-5"><a href="/#drop">Shop</a><a href="/bruffles" class="hidden sm:inline">Bruffles</a><a href="/passport" class="hidden sm:inline">Passport</a></div>
      <a href="/" class="h-bsa text-lg tracking-wide">BFA</a>
      <div class="flex gap-5"><a href="/authenticity" class="hidden sm:inline">Authenticity</a><CartCount client:load /></div>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="border-t border-line mt-24">
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 py-12 grid gap-8 sm:grid-cols-3 text-[13px] text-ink-soft">
      <p>Bruffles Apparel × Passport to Paradise<br />Trinidad & Tobago</p>
      <p class="flex flex-col gap-2"><a href="#">Returns</a><a href="#">Delivery</a><a href="#">Privacy</a></p>
      <p class="flex flex-col gap-2"><a href="/authenticity">Sourcing & authenticity</a><a href="#">Contact</a></p>
    </div>
  </footer>
  <script>
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("is-in"), io.unobserve(e.target))), { threshold: 0.4 });
    document.querySelectorAll(".tag-in").forEach((el) => io.observe(el));
  </script>
</body>
</html>
