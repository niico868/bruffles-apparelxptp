---
// The sold archive: the last pieces that found owners. Social proof without fake numbers.
import { bruffles, pad } from "../data/products";
const gone = bruffles.filter((p) => p.sold);
---
<section class="bf pb-[var(--spacing-section)]" aria-labelledby="gone">
  <div class="wrap flex items-end justify-between gap-4 border-t border-hair pt-12">
    <div><p class="label-bf text-ink-soft rise">The archive</p><h2 id="gone" class="h-bf text-[32px] md:text-[48px] mt-2 rise" style="--i:1">Gone. Found their owners.</h2></div>
    <a href="/bruffles" class="label-bf hover:text-gold-text shrink-0">See what's left</a>
  </div>
  <ul class="wrap mt-12 flex gap-4 md:gap-8 overflow-x-auto snap-x [scrollbar-width:thin] pb-4">
    {gone.map((p) => (
      <li class="snap-start shrink-0 w-[60%] sm:w-[40%] md:w-[24%]">
        <a href={`/bruffles/${p.id}`} class="group block">
          <div class="relative aspect-[4/5] ph-bf grayscale opacity-60 overflow-hidden">
            <span aria-hidden class="absolute right-3 bottom-1 num-bf text-[64px] text-ink/15">{pad(p.pieceNo)}</span>
          </div>
          <p class="mt-3 label-bf text-ink-soft">Piece {pad(p.pieceNo)} · {p.maker}</p>
          <p class="mt-1 truncate group-hover:underline underline-offset-4 decoration-hair">{p.name}</p>
          <p class="text-ink-soft">Found its owner</p>
        </a>
      </li>
    ))}
  </ul>
</section>
