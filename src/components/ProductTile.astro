---
// KOI-style product tile: one flat-lay photo, then maker · size, name, price in the uppercase UI voice.
import Img from "./Img.astro";
import { toPic } from "../lib/pic";
import { pieceImages } from "../data/media";
import { formatPrice } from "../lib/price";
import { pad, type BrufflesPiece } from "../data/products";
import { getSignals } from "../data/demo-signals";
import DemandLine from "./DemandLine";
const { p, sizes = "(min-width: 768px) 45vw, 50vw", i = 0 } = Astro.props as { p: BrufflesPiece; sizes?: string; i?: number };
const pic = await toPic(pieceImages(p.id, p.name)[0], [480, 800, 1200]);
const n = pad(p.pieceNo);
const sig = getSignals(p.pieceNo);
---
<article class="group/card rise" style={`--i:${i}`}>
  <a href={`/bruffles/${p.id}`} class="block" aria-label={`${p.name}, piece ${n}, ${p.sold ? "found its owner" : formatPrice(p.priceUsd)}`}>
    <div class="relative">
      <div class:list={["relative aspect-[4/5] overflow-hidden", p.sold && "gone-img"]}>
        <Img pic={pic} sizes={sizes} label={`Photo · ${n}`} />
      </div>
      {!p.sold && <span class="absolute left-3 bottom-3 label-bf text-gold-text bg-bone/90 px-2 py-1 pointer-events-none">1 of 1</span>}
      {p.sold && <span class="gone-stamp right-3 top-3" aria-hidden="true">Gone</span>}
    </div>
    <div class="mt-3 flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="ui text-ink-soft text-[12px] md:text-[13px]">{p.maker} · {p.size}</p>
        <h3 class="ui mt-1 text-[14px] md:text-[15px] group-hover/card:underline underline-offset-4 decoration-hair">{p.name}</h3>
        {!p.sold && <p class="ui mt-1 tabular-nums">{formatPrice(p.priceUsd)}</p>}
      </div>
      <span aria-hidden class="hidden sm:inline num-bf text-[32px] md:text-[48px] text-ink/80 transition-colors duration-700 group-hover/card:text-gold-deep">{n}</span>
    </div>
  </a>
  {!p.sold && <DemandLine client:visible id={p.id} bags={sig.bags} saves={sig.saves} />}
</article>
