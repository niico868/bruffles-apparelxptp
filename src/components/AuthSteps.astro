---
// "How authenticity works": the brand's core promise in three steps.
const steps = [
  { t: "Bought from official stores", d: "Every piece is purchased from the brand's own official store.",
    icon: `<path d="M4 9h16l-1.5 11h-13z"/><path d="M8.5 9V7a3.5 3.5 0 0 1 7 0v2"/>` },
  { t: "Receipt kept per restock", d: "The receipt for every restock stays on file, so each piece traces back to its purchase.",
    icon: `<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6M9 16h3"/>` },
  { t: "Tag photo on every piece", d: "Each piece is photographed with its brand tag, so you see exactly what arrives.",
    icon: `<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/>` },
];
const { heading = true } = Astro.props as { heading?: boolean };
---
<section class="bf py-[var(--spacing-section)]" aria-labelledby="auth-how">
  <div class="wrap">
    <div class="md:grid md:grid-cols-12 md:gap-8 items-end">
      <p class="label-bf text-gold-text md:col-span-12 rise">The promise</p>
      <h2 id="auth-how" class="h-bf text-[40px] md:text-[64px] mt-2 md:col-span-7 rise" style="--i:1">How authenticity works</h2>
      {heading && <a href="/authenticity" class="label-bf md:col-span-5 md:text-right hover:text-gold-text inline-block mt-4 md:mt-0 rise" style="--i:2">Read the full sourcing promise</a>}
    </div>
    <ol class="mt-16 grid gap-px bg-hair border border-hair md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="bg-bone p-8 md:p-12 rise" style={`--i:${i}`}>
          <div class="flex items-center justify-between">
            <span class="num-bf text-[64px] text-gold-deep">0{i + 1}</span>
            <svg aria-hidden width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" class="text-ink" set:html={s.icon} />
          </div>
          <h3 class="mt-12 text-[20px] font-semibold">{s.t}</h3>
          <p class="mt-3 text-ink-soft">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
