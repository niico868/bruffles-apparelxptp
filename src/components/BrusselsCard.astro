---
import { GoneStamp } from "./Gallery";
import { formatPrice } from "../lib/price";
import { pad, type BrusselsPiece } from "../data/products";
const { p } = Astro.props as { p: BrusselsPiece };
---
<a href={`/brussels/${p.id}`} class="group block">
  <div class="relative aspect-[4/5] overflow-hidden bg-paper-2">
    <div class:list={["absolute inset-0 bg-[radial-gradient(ellipse_at_50%_45%,#f7f3ec,#e4ddcf)] transition-transform duration-[1200ms] ease-[var(--ease-calm)] group-hover:scale-[1.04]", p.sold && "opacity-45 grayscale"]} />
    {p.sold ? <GoneStamp small /> : <span class="absolute top-3 left-3 label-bsa text-[10px] text-gold-deep">1 of 1</span>}
  </div>
  <div class="pt-3 tag-in">
    <p class="label-bsa text-ink-soft">Piece {pad(p.pieceNo)} · {p.maker}</p>
    <div class:list={["flex justify-between mt-1 text-sm", p.sold && "text-ink-soft"]}>
      <span>{p.name}</span><span class="tabular-nums">{p.sold ? "Gone" : formatPrice(p.priceUsd)}</span>
    </div>
  </div>
</a>
