---
// Card skeleton matches PassportCard exactly: 4:5 image, then a fixed-height meta block (h-24),
// so Bruffels and Passport rows line up side by side.
import { GoneStamp } from "./Gallery";
import { formatPrice } from "../lib/price";
import { pad, type BruffelsPiece } from "../data/products";
const { p } = Astro.props as { p: BruffelsPiece };
---
<a href={`/bruffels/${p.id}`} class="group block bg-paper-2/40">
  <div class="relative aspect-[4/5] overflow-hidden bg-paper-2">
    <div class:list={["absolute inset-0 bg-[radial-gradient(ellipse_at_50%_45%,#f8f4ee,#e6ddd4)] transition-transform duration-[1200ms] ease-[var(--ease-calm)] group-hover:scale-[1.04]", p.sold && "opacity-45 grayscale"]} />
    {p.sold ? <GoneStamp small /> : <span class="absolute top-3 left-3 label-bsa text-[10px] text-gold-deep">1 of 1</span>}
  </div>
  <div class="h-24 p-4 flex flex-col justify-between tag-in">
    <p class="label-bsa text-ink-soft">Piece {pad(p.pieceNo)} · {p.maker}</p>
    <div class:list={["text-sm md:flex md:justify-between md:gap-2", p.sold && "text-ink-soft"]}>
      <p class="truncate">{p.name}</p><p class="tabular-nums shrink-0">{p.sold ? "Gone" : formatPrice(p.priceUsd)}</p>
    </div>
  </div>
</a>
