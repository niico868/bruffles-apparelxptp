---
// One brand column. Both brands use this exact frame (padding, header height, grid),
// so their product rows line up left to right, division by division.
const { brand, title, href, tag, id } = Astro.props as { brand: "bsa" | "ptp"; title: string; href: string; tag: string; id?: string };
const dark = brand === "ptp";
---
<div id={id} class:list={["p-4 md:p-8", dark ? "runway text-chalk relative overflow-hidden" : "royal-field text-chalk"]}>
  <slot name="art" />
  <header class="relative z-10 h-16 flex items-center justify-between">
    <h2 class:list={[dark ? "h-ptp text-xl" : "h-bsa text-2xl"]}>{title}</h2>
    <a href={href} class:list={[dark ? "label-ptp text-signal hover:text-chalk" : "label-bsa gold-text font-bold hover:opacity-80", "transition-colors"]}>{tag}</a>
    <div class="absolute inset-x-0 bottom-0"><slot name="rule" /></div>
  </header>
  <div class="relative z-10 grid grid-cols-2 gap-4 mt-4"><slot /></div>
</div>
