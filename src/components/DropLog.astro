---
// Drop Log (top of /bruffles). Round 5 (Divine 2026-11-26): about a third of the old poster.
//   Ticker band: past drops scroll by on a dark purple bar and end on a bold "Next drop".
//   Row 1: pulsing dot · "Drop" (white) "014" (gold) · Bruffles logo.
//   Row 2: "40 pieces" (white) · "Next drop: Friday 5 December".
//   Perforated line, then the call to action: "Get drop alerts 1 day early", WhatsApp first, then email.
// Behind it all: the drop photo. The top 20% is solid dark purple, then it fades to the clothes,
// with a 35% dark purple layer over the photo so the text always reads.
// Every number comes from getDemo() in demo-signals.ts. Date and "1 day early": [CLIENT TO CONFIRM].
import Img from "./Img.astro";
import DropAlerts from "./DropAlerts";
import Monogram from "./Monogram";
import { toPic } from "../lib/pic";
import { asset } from "../data/assets";
import { getDemo } from "../data/demo-signals";
import { pad } from "../data/products";
const { currentDrop: d, pastDrops } = getDemo();
const pic = await toPic(asset("drop-log", "drop/drop-packing"), [480, 800, 1200, 1600]);
---
<section class="bf" aria-labelledby="drop-log">
  <!-- the shop header is 144px; Base adds 80px, so 88px more leaves a 24px gap above the card -->
  <div class="wrap pt-[88px] pb-8 md:pb-12">
    <div class="drop-card relative overflow-hidden text-white">
      <div class="absolute inset-0" aria-hidden="true">
        <Img pic={pic} sizes="(min-width: 1440px) 1344px, (min-width: 768px) 92vw, 60vw" label="" />
        <div class="absolute inset-0 drop-shade"></div>
      </div>

      <!-- Ticker: past drops roll across, ending on the next drop in bold -->
      <div class="drop-ticker relative z-10 overflow-hidden" role="marquee" aria-label={`Past drops, then next drop ${d.nextLong}`}>
        <div class="drop-ticker-track">
          {[0, 1].map((k) => (
            <span class="drop-ticker-run" aria-hidden={k === 1 ? "true" : undefined}>
              {pastDrops.map((p) => (
                <span class="drop-tick">Drop {pad(p.number)} · {p.pieces} pieces · <span class="text-mauve">{p.gone} gone</span></span>
              ))}
              <span class="drop-tick font-bold text-white">Next drop: {d.nextLong}</span>
            </span>
          ))}
        </div>
      </div>

      <div class="relative z-10 px-5 md:px-8 pt-5 md:pt-6 pb-6 md:pb-7 grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:gap-x-10 md:items-end">
        <div>
          <div class="flex items-center gap-3">
            <span class="drop-dot shrink-0" aria-hidden="true"></span>
            <h1 id="drop-log" class="flex items-baseline gap-2 leading-none">
              <span class="h-bf text-[32px] md:text-[40px] text-white">Drop</span>
              <span class="num-bf text-[32px] md:text-[40px] text-gold tabular-nums">{pad(d.number)}</span>
            </h1>
            <Monogram tone="bright" size={88} className="ml-auto md:ml-4 w-9 md:w-10 h-auto shrink-0" />
          </div>
          <p class="ui text-[13px] md:text-[14px] mt-3 flex flex-wrap gap-x-3 gap-y-1">
            <span class="text-white"><span class="tabular-nums">{d.pieces}</span> pieces</span>
            <span aria-hidden="true" class="text-gold">·</span>
            <span class="text-white/85">Next drop: <time class="text-white">{d.nextLong}</time></span>
          </p>
          <p class="sr-only">Bruffles Apparel: authentic menswear bought from official brand stores. Every piece is one of one.</p>
        </div>

        <div class="drop-perf my-5 md:hidden" aria-hidden="true"></div>

        <div class="md:border-l md:border-dashed md:border-white/40 md:pl-10">
          <p class="h-bf text-[20px] md:text-[22px] leading-tight">Get drop alerts <em class="text-gold not-italic">1 day early</em></p>
          <div class="mt-3"><DropAlerts client:visible dark slim /></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .drop-card { background: var(--color-plum); box-shadow: inset 0 0 0 1px rgb(201 162 78 / .35);
    text-shadow: 0 1px 2px rgb(20 10 28 / .85), 0 0 22px rgb(20 10 28 / .6); }
  .drop-card :global(input) { background: rgb(42 27 51 / .7); text-shadow: none; }
  .drop-card :global(button) { text-shadow: none; }
  .drop-card :global(img) { object-position: 50% 60%; }
  /* Solid dark purple for the top 20%, then the photo shows through, always under a 35% purple layer. */
  .drop-shade { background:
      linear-gradient(to bottom, var(--color-plum) 0%, var(--color-plum) 20%, rgb(42 27 51 / 0) 62%),
      rgb(42 27 51 / .35); }
  .drop-ticker { background: var(--color-plum); border-bottom: 1px solid rgb(199 168 218 / .3); }
  .drop-ticker-track { display: flex; width: max-content; animation: drop-tick 32s linear infinite; }
  .drop-ticker-run { display: flex; flex-shrink: 0; }
  .drop-tick { font-family: var(--font-ui); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap;
    padding: 9px 22px; color: rgb(255 255 255 / .88); }
  .drop-tick + .drop-tick { border-left: 1px solid rgb(199 168 218 / .35); }
  @keyframes drop-tick { to { transform: translateX(-50%); } }
  .drop-dot { width: 10px; height: 10px; border-radius: 999px; background: var(--color-gold); animation: drop-pulse 2.2s infinite; }
  @keyframes drop-pulse { 0% { box-shadow: 0 0 0 0 rgb(201 162 78 / .6); } 70% { box-shadow: 0 0 0 10px rgb(201 162 78 / 0); } 100% { box-shadow: 0 0 0 0 rgb(201 162 78 / 0); } }
  /* Ticket perforation */
  .drop-perf { height: 1px; background-image: linear-gradient(90deg, rgb(255 255 255 / .5) 50%, transparent 50%); background-size: 10px 1px; }
  @media (prefers-reduced-motion: reduce) { .drop-ticker-track, .drop-dot { animation: none; } }
</style>
