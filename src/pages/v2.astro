---
// Homepage 2 (Divine round 5, 2026-11-26): a second view of the homepage for customers to compare.
// The original homepage (/) stays as it is; this page links back to it from the menu row.
//
//  - Hero: the same split hero, but the seam is vertical on every screen (phones too). Copy compacts
//    and stacks word over word; tapping a side opens it to 70% sideways; films, tear and circle as before.
//  - Below the hero the page is split 50/50, fixed (no 70/30): Bruffles on white on the left, Passport
//    on dark purple (--color-plum) on the right, row by row so each topic sits beside its partner.
//  - No product grid: a small catalogue, each photo half the old tile size, caption under each.
//  - Plain, everyday wording (every change is listed in docs/round5-copy.md).
//  - Only the footer runs full width.
import Base from "../layouts/Base.astro";
import SplitHero from "../components/SplitHero";
import Img from "../components/Img.astro";
import WallCard from "../components/WallCard.astro";
import { bruffles, passport } from "../data/products";
import { media, pieceImages } from "../data/media";
import { asset } from "../data/assets";
import { wall } from "../data/wall";
import { getDemo } from "../data/demo-signals";
import { toPic } from "../lib/pic";
import { formatPrice } from "../lib/price";

const hero = {
  bf: { desktop: await toPic(media.hero.bf.desktop), mobile: await toPic(media.hero.bf.mobile, [640, 1080]), video: media.hero.bf.video },
  pp: { desktop: await toPic(media.hero.pp.desktop), mobile: await toPic(media.hero.pp.mobile, [640, 1080]), video: media.hero.pp.video },
};
const latest = await Promise.all(bruffles.filter((p) => !p.sold).slice(0, 4).map(async (p) => ({ p, pic: await toPic(pieceImages(p.id, p.name)[0], [240, 360, 560]) })));
const ppPics = await Promise.all(media.ppTwoUp.map(async (s) => ({ s, pic: await toPic(s, [240, 360, 560]) })));
const hunt = [
  { cap: "The tag", pic: await toPic(asset("hunt-label", "hunt/hunt-label"), [240, 480, 800]) },
  { cap: "The receipt", pic: await toPic(asset("hunt-receipt", "hunt/hunt-receipt"), [240, 480, 800]) },
  { cap: "The check", pic: await toPic(asset("hunt-stitching", "hunt/hunt-stitching"), [240, 480, 800]) },
];
const steps = [
  { t: "Bought from official stores", d: "We buy every piece from the brand's own official store." },
  { t: "Document receipts every restock", d: "We keep the receipt from every restock, so you can trace each piece back to where we bought it." },
  { t: "Every piece's hang tag photo", d: "We photograph every piece with its hang tag on, so you see exactly what you're getting." },
  { t: "Verify on delivery", d: "When your piece arrives, scan the QR code on your package card and sign for it. Add a fit pic if you like." },
];
// Wall on homepage 2 (Divine round 5): two photo cards and two text cards. Swap names here.
const WALL_V2 = [
  { id: "BA-040", photo: true },   // Jaden, Tunapuna
  { id: "BA-046", photo: false },  // Darnell, Arima
  { id: "BA-038", photo: true },   // Aaliyah, Diego Martin
  { id: "BA-041", photo: false },  // Shania, Port of Spain
];
const wallCards = WALL_V2.map(({ id, photo }) => { const c = wall.find((w) => w.id === id)!; return photo ? c : { ...c, fit: undefined }; });
const { signedFor } = getDemo();
const catSizes = "(min-width: 1440px) 330px, 23vw";
---
<Base title="Bruffles Apparel × Passport to Paradise · Homepage 2" shop white offset={false}>
  <SplitHero client:load media={hero} vertical cta="Shop Bruffles" />

  <div class="v2">
    <!-- Row 1: the newest pieces beside Passport's shop -->
    <div class="v2-row">
      <section class="v2-bf" aria-labelledby="v2-latest">
        <div class="v2-in">
          <p class="h-bf v2-eyebrow text-gold-text rise">Bruffles Apparel · 1 of 1</p>
          <h2 id="v2-latest" class="h-bf v2-h rise" style="--i:1">Latest pieces</h2>
          <a href="/bruffles" class="v2-link text-gold-text decoration-gold-deep/50 rise" style="--i:2">Shop Bruffles</a>
          <ul class="v2-cat mt-6 md:mt-10">
            {latest.map(({ p, pic }, i) => (
              <li class="rise" style={`--i:${i}`}>
                <a href={`/bruffles/${p.id}`} class="group/c block">
                  <div class="v2-thumb relative aspect-[4/5] overflow-hidden bg-bone-2"><Img pic={pic} sizes={catSizes} label={p.id} /></div>
                  <p class="v2-cap-sm text-gold-text mt-2">{p.maker} · {p.size}</p>
                  <h3 class="v2-cap group-hover/c:underline underline-offset-4 decoration-hair">{p.name}</h3>
                  <p class="v2-cap-sm tabular-nums mt-0.5">{formatPrice(p.priceUsd)} <span class="text-gold-text">· 1 of 1</span></p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="v2-pp" aria-labelledby="v2-pp-shop">
        <div class="v2-in">
          <p class="label-pp v2-eyebrow-pp text-mauve rise">Passport to Paradise · 18+</p>
          <h2 id="v2-pp-shop" class="h-pp v2-h rise" style="--i:1">Shop Passport</h2>
          <a href="/passport" class="v2-link text-signal decoration-signal/50 rise" style="--i:2">Shop all Passport</a>
          <ul class="v2-cat mt-6 md:mt-10">
            {ppPics.map(({ s, pic }, i) => (
              <li class="rise" style={`--i:${i}`}>
                <a href={s.href} class="group/c block">
                  <div class="v2-thumb relative aspect-[4/5] overflow-hidden bg-plum-2"><Img pic={pic} world="pp" sizes={catSizes} label={s.button} /></div>
                  <h3 class="v2-cap mt-2 group-hover/c:underline underline-offset-4">{s.button}</h3>
                </a>
              </li>
            ))}
          </ul>
          <!-- Price list as a small catalogue: product photos stay behind the 18+ check on /passport -->
          <ul class="mt-8 md:mt-12 border-t border-white/15">
            {passport.map((it) => (
              <li class="border-b border-white/15">
                <a href={`/passport/${it.id}`} class="block py-3 hover:bg-white/5">
                  <h3 class="v2-cap text-white">{it.name}</h3>
                  <p class="v2-cap-sm text-white/70 mt-0.5">{it.packOf > 1 ? `Pack of ${it.packOf}` : "Single"} · <span class="tabular-nums text-white">{formatPrice(it.priceUsd)}</span></p>
                  <p class:list={["v2-cap-sm mt-0.5", it.qty === 0 ? "text-white/55" : "text-signal"]}>{it.qty === 0 ? "Sold out" : "In stock"}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <!-- Row 2: Authenticity matters (Bruffles) beside what Passport sells -->
    <div class="v2-row">
      <section class="v2-bf" aria-labelledby="v2-auth">
        <div class="v2-in">
          <p class="label-bf text-gold-text rise">How we know it's real</p>
          <h2 id="v2-auth" class="h-bf v2-h mt-2 rise" style="--i:1">Authenticity <span class="text-gold-text italic">matters</span></h2>
          <h3 class="label-bf text-gold-text mt-8 md:mt-10">How authenticity works</h3>
          <ol class="mt-3 border-t border-hair">
            {steps.map((s, i) => (
              <li class="py-4 border-b border-hair rise" style={`--i:${i}`}>
                <span class="num-bf text-[28px] md:text-[36px] text-gold-deep leading-none">0{i + 1}</span>
                <p class="ui text-[13px] md:text-[14px] mt-2">{s.t}</p>
                <p class="text-[13px] md:text-[14px] text-ink-soft mt-1">{s.d}</p>
              </li>
            ))}
          </ol>
          <!-- The tag, the receipt, the check: same size as on homepage 1, one above the other -->
          <ul class="mt-8 md:mt-10 space-y-6">
            {hunt.map((t, i) => (
              <li class="rise v2-hunt" style={`--i:${i}`}>
                <a href="/bruffles" class="group/t block">
                  <div class="relative aspect-[4/5] overflow-hidden ph-bf"><Img pic={t.pic} sizes="(min-width: 1340px) 400px, 30vw" label={t.cap} /></div>
                  <p class="label-bf text-gold-text !text-[12px] md:!text-[13px] mt-2 group-hover/t:underline underline-offset-4">{t.cap}</p>
                </a>
              </li>
            ))}
          </ul>
          <a href="/authenticity" class="v2-link text-gold-text decoration-gold-deep/50 mt-8">Read how we source every piece</a>
        </div>
      </section>

      <section class="v2-pp" aria-labelledby="v2-pp-what">
        <div class="v2-in v2-stick">
          <p class="label-pp v2-eyebrow-pp text-mauve">What Passport sells</p>
          <h2 id="v2-pp-what" class="h-pp v2-h">Papers, filters <span class="text-signal">and tools</span></h2>
          <ol class="mt-8 md:mt-10 border-t border-white/15">
            <li class="py-4 border-b border-white/15"><p class="v2-cap text-white">Rolling papers</p><p class="v2-cap-sm text-white/70 mt-1">King slim, unbleached. By the box.</p></li>
            <li class="py-4 border-b border-white/15"><p class="v2-cap text-white">Filters and tips</p><p class="v2-cap-sm text-white/70 mt-1">Card filter tips and glass tips. By the pack.</p></li>
            <li class="py-4 border-b border-white/15"><p class="v2-cap text-white">Tools</p><p class="v2-cap-sm text-white/70 mt-1">Grinders, rolling trays and stash tins.</p></li>
            <li class="py-4 border-b border-white/15"><p class="v2-cap text-white">18+ only</p><p class="v2-cap-sm text-white/70 mt-1">You confirm your age before you can shop Passport.</p></li>
          </ol>
          <a href="/passport" class="btn-pp label-pp mt-8 !min-h-11 !px-4 !text-[11px] md:!text-[12px]">Shop Passport <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </div>

    <!-- Row 3: Seal of authenticity (Bruffles only) beside Passport's badge -->
    <div class="v2-row">
      <section id="wall" class="v2-bf scroll-mt-40" aria-labelledby="v2-wall">
        <div class="v2-in">
          <h2 id="v2-wall" class="h-bf v2-h rise">Seal of <span class="text-gold-text italic">authenticity</span></h2>
          <p class="h-bf text-[17px] md:text-[24px] text-ink-soft mt-1 rise" style="--i:1">We recognize real.</p>
          <p class="ui text-[11px] md:text-[13px] text-ink-soft mt-3 rise" style="--i:2">
            <span class="inline-flex items-center gap-1.5"><img src="/brand/bruffles-monogram-gold-deep.webp" alt="" aria-hidden="true" width="16" height="16" />Customer verified</span>
            <span class="block md:inline md:ml-2"><span class="tabular-nums">{signedFor}</span> pieces signed for</span></p>
          <div class="v2-wall mt-8 md:mt-12">
            {wallCards.map((c, i) => <WallCard card={c} i={i} />)}
          </div>
          <p class="text-[13px] md:text-[16px] mt-10">Got a piece? Scan the QR code on your package card to sign for it.</p>
          <a href="/authenticity" class="v2-link text-ink decoration-hair mt-2">How signing for your piece works</a>
          <p class="mt-4 text-[11px] text-ink-soft">Sample cards for the demo.</p>
        </div>
      </section>

      <section class="v2-pp" aria-label="Passport to Paradise">
        <div class="v2-in v2-stick flex flex-col items-start">
          <img src="/brand/passport-badge.webp" alt="Passport to Paradise logo" width="594" height="505" loading="lazy" decoding="async" class="w-[min(100%,260px)] h-auto" />
          <p class="h-pp v2-h mt-6">Passport <br />to Paradise</p>
          <p class="v2-cap-sm text-white/70 mt-2">Papers, filters and tools, by the pack and by the box.</p>
          <a href="/passport" class="btn-pp label-pp mt-6 !min-h-11 !px-4 !text-[11px] md:!text-[12px]">Shop Passport <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  /* Two fixed halves, row by row. Each half pads in from the page edge and from the centre line. */
  .v2-row { display: grid; grid-template-columns: 1fr 1fr; }
  .v2-bf { background: #fff; color: var(--color-ink); }
  .v2-pp { background: var(--color-plum); color: #fff; border-left: 1px solid rgb(201 162 78 / .35); }
  .v2-in { padding: clamp(40px, 8vw, 112px) clamp(12px, 4vw, 64px); max-width: 640px; }
  .v2-bf .v2-in { margin-left: auto; }
  .v2-pp .v2-in { margin-right: auto; }
  .v2-row + .v2-row .v2-in { padding-top: clamp(32px, 5vw, 80px); }
  .v2-row + .v2-row { border-top: 1px solid var(--color-hair); }
  .v2-row + .v2-row .v2-pp { border-top: 1px solid rgb(255 255 255 / .12); }
  /* Passport side follows you down while the longer Bruffles side scrolls (computer and phone). */
  .v2-stick { position: sticky; top: 168px; }

  .v2-eyebrow { font-size: clamp(14px, 1.6vw, 20px); }
  .v2-eyebrow-pp { font-size: clamp(10px, 1.1vw, 12px); }
  .v2-h { font-size: clamp(26px, 5vw, 64px); margin-top: .15em; overflow-wrap: anywhere; hyphens: manual; }
  .v2-pp .v2-h.h-pp { font-size: clamp(22px, 4.4vw, 56px); }
  .v2-link { display: inline-block; margin-top: 10px; font-family: var(--font-ui); font-size: clamp(12px, 1.2vw, 15px); text-transform: uppercase; letter-spacing: .06em;
    text-decoration-line: underline; text-underline-offset: 4px; }

  /* Small catalogue: photos at half the homepage-1 tile width, one above the other, caption under each. */
  .v2-cat { display: grid; gap: clamp(20px, 3vw, 36px); }
  .v2-thumb { width: clamp(84px, calc((min(100vw, 1440px) - 2 * var(--spacing-gutter) - 24px) / 4), 330px); }
  .v2-cap { font-family: var(--font-ui); font-size: clamp(12px, 1.1vw, 15px); line-height: 1.3; letter-spacing: .02em; }
  .v2-cap-sm { font-family: var(--font-ui); font-size: clamp(11px, 1vw, 13px); line-height: 1.35; letter-spacing: .04em; text-transform: uppercase; }
  .v2-hunt { width: min(29vw, 400px); }

  /* Wall: two cards across on a computer, one above the other on a phone. */
  .v2-wall { display: grid; grid-template-columns: 1fr; gap: 28px; max-width: 520px; }
  @media (min-width: 900px) { .v2-wall { grid-template-columns: 1fr 1fr; gap: 36px 28px; } }
  @media (max-width: 767px) { .v2-stick { top: 160px; } }
</style>
