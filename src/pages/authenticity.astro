---
import Base from "../layouts/Base.astro";
const steps = [
  ["Bought from official stores", "Every Bruffles piece is purchased from the brand's official store."],
  ["Receipt kept per restock", "We keep the receipt for every restock, so each piece can be traced back to its purchase."],
  ["Tag photo on every piece", "Each piece is photographed with its brand tag, so you see exactly what arrives."],
];
---
<Base title="Sourcing & authenticity · Bruffles Apparel" world="bf">
  <section class="max-w-3xl mx-auto px-4 md:px-8 pt-12">
    <p class="label-bf text-gold-text tag-in">Sourcing & authenticity</p>
    <h1 class="h-bf text-3xl md:text-4xl mt-3">Authentic, to an absurd degree.</h1>
    <ol class="mt-12 divide-y divide-hair border-y border-hair">
      {steps.map(([t, d], i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-6">
          <span class="label-bf text-gold-text pt-1">0{i + 1}</span>
          <div><h2 class="text-base font-semibold">{t}</h2><p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{d}</p></div>
        </li>
      ))}
    </ol>
  </section>
</Base>
