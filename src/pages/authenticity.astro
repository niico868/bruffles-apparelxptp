---
import Base from "../layouts/Base.astro";
const steps = [
  ["Sourced", "Every Bruffels piece is bought new from the brand's official store: nike.com, stussy.com and the like. Never resellers."],
  ["Receipted", "We keep the original order receipt for every restock and link it to each piece it covers."],
  ["Photographed", "Six standard shots per piece, including the brand tag, so you see exactly what arrives."],
  ["Numbered", "Each piece gets a permanent ID (BFA-047) and a digital passport page that lives on after it sells."],
  ["Certified", "Your certificate of authenticity is emailed the moment you buy."],
];
---
<Base title="Sourcing & authenticity · Bruffels Apparel">
  <section class="max-w-3xl mx-auto px-4 md:px-8 pt-12">
    <p class="label-bsa text-gold-deep tag-in">Sourcing & authenticity</p>
    <h1 class="h-bsa text-3xl md:text-4xl mt-3">Authentic, to an absurd degree.</h1>
    <ol class="mt-12 divide-y divide-line border-y border-line">
      {steps.map(([t, d], i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-6">
          <span class="label-bsa text-gold-deep pt-1">0{i + 1}</span>
          <div><h2 class="text-base font-semibold">{t}</h2><p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{d}</p></div>
        </li>
      ))}
    </ol>
  </section>
</Base>
