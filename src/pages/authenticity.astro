---
import Base from "../layouts/Base.astro";
import AuthSteps from "../components/AuthSteps.astro";
---
<Base title="Sourcing & authenticity · Bruffles Apparel" world="bf">
  <section class="wrap pt-32 md:pt-40">
    <p class="label-bf text-gold-text rise">Sourcing & authenticity</p>
    <h1 class="h-bf text-[48px] md:text-[96px] mt-2 max-w-[14ch] rise" style="--i:1">Purchased from official brand stores.</h1>
    <p class="mt-6 max-w-[52ch] text-ink-soft rise" style="--i:2">Receipt on file for every restock. Bruffles is not affiliated with or endorsed by the brands it sells.</p>
  </section>
  <AuthSteps heading={false} />
</Base>
