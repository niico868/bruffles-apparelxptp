---
// Homepage (order set 2026-11-25): hero → Latest pieces (shared drop) → How authenticity works
// (with the Hunt teaser) → Shop Passport → Customer Verified wall → footer (holds drop alerts).
// Both brands on equal footing. The campaign film block returns once a film exists.
import Base from "../layouts/Base.astro";
import SplitHero from "../components/SplitHero";
import ProductTile from "../components/ProductTile.astro";
import AuthSteps from "../components/AuthSteps.astro";
import HuntTeaser from "../components/HuntTeaser.astro";
import PassportTwoUp from "../components/PassportTwoUp.astro";
import PassportList from "../components/PassportList";
import CustomerWall from "../components/CustomerWall.astro";
import { bruffles, passport } from "../data/products";
import { media, pieceImages } from "../data/media";
import { toPic } from "../lib/pic";
const latest = bruffles.filter((p) => !p.sold).slice(0, 4);
const hero = {
  bf: { desktop: await toPic(media.hero.bf.desktop), mobile: await toPic(media.hero.bf.mobile, [640, 1080]), video: media.hero.bf.video },
  pp: { desktop: await toPic(media.hero.pp.desktop), mobile: await toPic(media.hero.pp.mobile, [640, 1080]), video: media.hero.pp.video },
};
const shareImage = hero.bf.desktop ? (await toPic(media.hero.bf.desktop, [1200]))?.src : undefined;
---
<Base image={shareImage}>
  <SplitHero client:load media={hero} />

  <section class="bf pt-[var(--spacing-section)] pb-16 md:pb-24" aria-labelledby="latest">
    <div class="wrap text-center">
      <p class="label-bf text-gold-text rise">Bruffles Apparel · 1 of 1</p>
      <h2 id="latest" class="h-koi text-[32px] md:text-[48px] mt-2 rise" style="--i:1">Latest pieces</h2>
      <a href="/bruffles" class="ui inline-block mt-3 text-gold-text underline underline-offset-4 decoration-gold-deep/50 hover:decoration-gold-deep rise" style="--i:2">Shop Bruffles</a>
    </div>
    <div class="wrap grid grid-cols-2 gap-2 md:gap-6 mt-10 md:mt-12">
      {latest.map((p, i) => <ProductTile p={p} i={i % 2} loop />)}
    </div>
  </section>

  <section class="bf" aria-labelledby="auth-matters">
    <div class="wrap pt-4 pb-10 md:pb-12 text-center">
      <p class="label-bf text-gold-text rise">Bought, kept, checked</p>
      <h2 id="auth-matters" class="h-bf text-[36px] md:text-[56px] mt-2 rise" style="--i:1">Authenticity <span class="text-gold-text italic">matters</span></h2>
    </div>
  </section>
  <AuthSteps strip />
  <HuntTeaser />

  <section class="pp py-[var(--spacing-section)]" aria-labelledby="pp-shop">
    <div class="wrap flex items-end justify-between gap-4 pb-8">
      <div><p class="label-pp text-signal">Passport to Paradise · 18+</p><h2 id="pp-shop" class="h-pp text-[40px] md:text-[64px] mt-2">Shop Passport</h2></div>
      <a href="/passport" class="label-pp hover:text-signal">Shop all →</a>
    </div>
    <div class="wrap"><PassportTwoUp /></div>
    <div class="wrap mt-8"><PassportList items={passport.slice(0, 4)} /></div>
  </section>

  <CustomerWall />
</Base>
