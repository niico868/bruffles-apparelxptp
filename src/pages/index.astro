---
// Homepage, KOI merge: "the flagship store with a street-campaign window". Exactly 8 blocks:
// 1 header (layout) · 2 split hero · 3 latest pieces · 4 authenticity strip · 5 film
// 6 Passport · 7 community wall · 8 footer (layout, holds drop alerts)
import Base from "../layouts/Base.astro";
import SplitHero from "../components/SplitHero";
import ProductTile from "../components/ProductTile.astro";
import AuthSteps from "../components/AuthSteps.astro";
import Film from "../components/Film.astro";
import PassportTwoUp from "../components/PassportTwoUp.astro";
import DepartureBoard from "../components/DepartureBoard";
import WallMosaic from "../components/WallMosaic.astro";
import { bruffles, passport } from "../data/products";
import { media, pieceImages } from "../data/media";
import { toPic } from "../lib/pic";
const latest = bruffles.filter((p) => !p.sold).slice(0, 2);
const hero = {
  bf: { desktop: await toPic(media.hero.bf.desktop), mobile: await toPic(media.hero.bf.mobile, [640, 1080]), video: media.hero.bf.video },
  pp: { desktop: await toPic(media.hero.pp.desktop), mobile: await toPic(media.hero.pp.mobile, [640, 1080]), video: media.hero.pp.video },
};
const featured = await toPic(pieceImages("BA-047", "Tech Fleece Windrunner")[0], [480, 800, 1200]);
const shareImage = hero.bf.desktop ? (await toPic(media.hero.bf.desktop, [1200]))?.src : undefined;
---
<Base image={shareImage}>
  <SplitHero client:load media={hero} featured={featured} />

  <section class="bf pt-[var(--spacing-section)] pb-16 md:pb-24" aria-labelledby="latest">
    <div class="wrap text-center">
      <h2 id="latest" class="h-koi text-[32px] md:text-[48px] rise">Latest pieces</h2>
      <a href="/bruffles" class="ui inline-block mt-3 underline underline-offset-4 decoration-hair hover:decoration-ink rise" style="--i:1">Shop Bruffles</a>
    </div>
    <div class="wrap grid grid-cols-2 gap-2 md:gap-6 mt-10 md:mt-12">
      {latest.map((p, i) => <ProductTile p={p} i={i} />)}
    </div>
  </section>

  <AuthSteps strip />

  <Film />

  <section class="pp py-[var(--spacing-section)]" aria-labelledby="pp-board">
    <div class="wrap flex items-end justify-between gap-4 pb-8">
      <div><p class="label-pp text-signal">Passport to Paradise · 18+</p><h2 id="pp-board" class="h-pp text-[40px] md:text-[64px] mt-2">Departures</h2></div>
      <a href="/passport" class="label-pp hover:text-signal">All departures →</a>
    </div>
    <div class="wrap"><PassportTwoUp /></div>
    <div class="wrap mt-8"><DepartureBoard items={passport.slice(0, 4)} /></div>
  </section>

  <WallMosaic />
</Base>
