---
import Base from "../layouts/Base.astro";
import SplitHero from "../components/SplitHero";
import BrufflesCard from "../components/BrufflesCard.astro";
import PassportCard from "../components/PassportCard";
import PlanePath from "../components/PlanePath";
import DropColumn from "../components/DropColumn.astro";
import TravelInk from "../components/TravelInk.astro";
import { bruffles, passport } from "../data/products";
---
<Base>
  <SplitHero client:load />

  <section id="drop" class="max-w-[1400px] mx-auto px-4 md:px-8 pt-24">
    <header class="flex items-baseline justify-between border-b border-line pb-4">
      <h1 class="text-[13px] tracking-[0.2em] uppercase">Shared Drop · November</h1>
      <p class="label-bsa text-ink-soft">Restocked twice a month</p>
    </header>

    <div class="grid md:grid-cols-2 mt-8">
      <DropColumn brand="bsa" title="Bruffles Apparel" href="/bruffles" tag="View all">
        {bruffles.map((p) => <BrufflesCard p={p} />)}
      </DropColumn>
      <DropColumn brand="ptp" title="Passport to Paradise" href="/passport" tag="All departures" id="passport">
        <TravelInk slot="art" />
        <PlanePath slot="rule" dark={false} client:visible />
        {passport.map((item) => <PassportCard client:visible item={item} />)}
      </DropColumn>
    </div>
  </section>
</Base>
