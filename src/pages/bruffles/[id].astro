---
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery";
import SizeDrawer from "../../components/SizeDrawer";
import AddPiece from "../../components/AddPiece";
import AskPiece from "../../components/AskPiece";
import Certificate from "../../components/Certificate.astro";
import { bruffles, pad } from "../../data/products";
import { formatPrice } from "../../lib/price";

export function getStaticPaths() {
  return bruffles.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const n = pad(p.pieceNo);
---
<Base title={`${p.name} · Piece ${n} · Bruffles Apparel`} description={p.description} world="bf">
  <div class="bf">
    <article class="wrap pt-20 md:pt-28 md:grid md:grid-cols-12 md:gap-12">
      <div class="md:col-span-7 lg:col-span-8"><Gallery client:visible sold={p.sold} num={n} /></div>

      <div class="md:col-span-5 lg:col-span-4 mt-8 md:mt-0">
        <div class="md:sticky md:top-24 pb-8">
          <nav class="label-bf text-ink-soft" aria-label="Breadcrumb"><a href="/bruffles" class="hover:text-ink">Bruffles</a> <span aria-hidden>/</span> Piece {n}</nav>
          <div class="mt-6 flex items-end justify-between gap-4">
            <span class="num-bf text-[72px] md:text-[96px]" aria-hidden>{n}</span>
            {p.sold ? <span class="label-bf text-ink-soft mb-2">Gone</span> : <span class="label-bf text-gold-text border border-gold-deep/60 px-2 py-1 mb-2">1 of 1</span>}
          </div>
          <p class="label-bf text-ink-soft mt-6">{p.maker} · Size {p.size}</p>
          <h1 class="h-bf text-[32px] md:text-[40px] mt-2">{p.name}</h1>
          <p class="mt-4 text-[20px] tabular-nums">{p.sold ? "Found its owner" : formatPrice(p.priceUsd)}</p>

          <div class="mt-8 space-y-3">
            <AddPiece client:load id={p.id} name={p.name} priceUsd={p.priceUsd} sold={p.sold} />
            <AskPiece client:idle num={n} />
          </div>
          <div class="mt-8"><SizeDrawer client:idle size={p.size} measurements={p.measurements} /></div>
          <p class="mt-8 text-ink-soft">{p.description}</p>
          <p class="mt-6 label-bf text-gold-text"><a href="#cert" class="hover:underline underline-offset-4">Purchased from official brand stores — receipt on file ↓</a></p>
        </div>
      </div>
    </article>
    <div class="wrap py-[var(--spacing-section)]"><Certificate p={p} /></div>
  </div>
</Base>
