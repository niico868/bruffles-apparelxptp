---
import Base from "../../layouts/Base.astro";
import BrufflesCard from "../../components/BrufflesCard.astro";
import { bruffles } from "../../data/products";
const available = bruffles.filter((p) => !p.sold).length;
---
<Base title="Bruffles Apparel · One of one menswear">
  <section class="max-w-[1400px] mx-auto px-4 md:px-8 pt-12">
    <p class="label-bsa text-gold-deep tag-in">Every piece 1 of 1 · {available} available</p>
    <h1 class="h-bsa text-3xl md:text-4xl mt-3">Bruffles Apparel</h1>
    <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-ink-soft">Authentic menswear purchased from official brand stores, receipt on file. Every piece is one of one.</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10">
      {bruffles.map((p) => <BrufflesCard p={p} />)}
    </div>
  </section>
</Base>
