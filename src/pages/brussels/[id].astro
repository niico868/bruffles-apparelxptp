---
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery";
import SizeDrawer from "../../components/SizeDrawer";
import AddPiece from "../../components/AddPiece";
import { brussels, pad } from "../../data/products";
import { formatPrice } from "../../lib/price";

export function getStaticPaths() {
  return brussels.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
---
<Base title={`${p.name} · ${p.id} · Brussels Apparel`} description={p.description}>
  <article class="max-w-[1400px] mx-auto px-4 md:px-8 pt-6 md:pt-12 md:grid md:grid-cols-[1.4fr_1fr] md:gap-16">
    <Gallery client:load sold={p.sold} />

    <div class="mt-8 md:mt-0 md:sticky md:top-24 self-start max-w-md">
      <p class="label-bsa text-gold-deep tag-in">Piece {pad(p.pieceNo)} · 1 of 1</p>
      <h1 class="h-bsa text-3xl md:text-4xl mt-3 leading-tight">{p.name}</h1>
      <p class="label-bsa text-ink-soft mt-2">{p.maker} · Size {p.size}</p>
      <p class="mt-6 text-lg tabular-nums">{p.sold ? "Gone" : formatPrice(p.priceUsd)}
        {!p.sold && <span class="text-sm text-ink-soft ml-2">≈ {formatPrice(p.priceUsd, "TTD")}</span>}</p>

      <div class="mt-8"><AddPiece client:load id={p.id} name={p.name} priceUsd={p.priceUsd} sold={p.sold} /></div>
      <div class="mt-3"><SizeDrawer client:idle size={p.size} measurements={p.measurements} /></div>

      <p class="mt-8 text-[15px] leading-relaxed text-ink-soft">{p.description}</p>

      <!-- Authenticity block -->
      <section class="mt-10 border-t border-line pt-6" aria-labelledby="auth">
        <h2 id="auth" class="label-bsa">Authenticity</h2>
        <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-sm">
          <dt class="text-ink-soft">Piece ID</dt><dd class="tabular-nums">{p.id}</dd>
          <dt class="text-ink-soft">Source</dt><dd>Sourced from {p.maker} · {p.source}</dd>
          <dt class="text-ink-soft">Condition</dt><dd>{p.condition}</dd>
          <dt class="text-ink-soft">Proof</dt><dd>{p.receiptRef ? <span>Receipt on file · {p.receiptRef}</span> : "Receipt pending"}</dd>
        </dl>
        <div class="mt-5 flex gap-4 items-center">
          <div class="w-20 aspect-square bg-paper-2 grid place-items-center label-bsa text-[9px] text-ink-soft">Tag</div>
          <a href="#" class="label-bsa underline underline-offset-4 decoration-line hover:decoration-ink">View digital passport</a>
        </div>
      </section>
    </div>
  </article>
</Base>
