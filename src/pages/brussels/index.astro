---
import Base from "../../layouts/Base.astro";
import BrusselsCard from "../../components/BrusselsCard.astro";
import { brussels } from "../../data/products";
const available = brussels.filter((p) => !p.sold).length;
---
<Base title="Brussels Apparel · One of one menswear">
  <section class="max-w-[1400px] mx-auto px-4 md:px-8 pt-12">
    <p class="label-bsa text-gold-deep tag-in">Every piece 1 of 1 · {available} available</p>
    <h1 class="h-bsa text-3xl md:text-4xl mt-3">Brussels Apparel</h1>
    <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-ink-soft">Authentic menswear sourced only from official brand stores. One size, one piece, never restocked. Proof of purchase on every item.</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10">
      {brussels.map((p) => <BrusselsCard p={p} />)}
    </div>
  </section>
</Base>
