---
import Base from "../layouts/Base.astro";
---
<Base title="Your bag · Bruffles Apparel × Passport to Paradise">
  <section class="wrap pt-32 pb-[var(--spacing-section)] max-w-3xl">
    <p class="label-bf text-gold-text">Your bag</p>
    <h1 class="h-bf text-[48px] mt-2">Checkout comes next.</h1>
    <p class="mt-6 text-ink-soft">This demo shows the shopping experience. Card checkout is part of the full website development.</p>
    <div class="mt-8 flex gap-3"><a href="/bruffles" class="btn-bf label-bf">Bruffles</a><a href="/passport" class="btn-bf-ghost label-bf">Passport</a></div>
  </section>
</Base>
