---
import Base from "../../layouts/Base.astro";
import PassportCard from "../../components/PassportCard";
import DepartureBoard from "../../components/DepartureBoard";
import { passport } from "../../data/products";
---
<Base title="Passport to Paradise · Departures" description="Papers, filters and tools from Passport to Paradise, by the pack and by the box." world="pp">
  <div class="pp">
    <section class="wrap pt-32 md:pt-40 pb-16 md:grid md:grid-cols-12 md:gap-8 md:items-end">
      <div class="md:col-span-7">
        <p class="label-pp text-signal">Gate 02 · All departures</p>
        <h1 class="h-pp text-[56px] md:text-[96px] mt-4">Passport<br />to Paradise</h1>
      </div>
      <div class="md:col-span-4 md:col-start-9 mt-6 md:mt-0">
        <img src="/brand/passport-badge.webp" alt="Passport to Paradise logo" width="594" height="505" class="w-40 md:w-56 mb-6" />
        <p class="text-muted">Papers, filters and tools, by the pack and by the box.</p>
      </div>
    </section>
    <section class="wrap pb-16" aria-label="Departures board"><DepartureBoard items={passport} /></section>
    <section class="wrap pb-[var(--spacing-section)]" aria-label="All items">
      <div class="flex items-center gap-4 pb-6"><span class="label-pp text-signal">→</span><h2 class="label-pp">All items</h2><span class="flex-1 border-t border-dashed border-char-3"></span></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {passport.map((item) => <PassportCard client:visible item={item} />)}
      </div>
    </section>
  </div>
</Base>
